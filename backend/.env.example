# Copy this file to ".env" and fill in the values.

# SQLAlchemy connection string. Format:
#   postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
# If your password contains special characters (@ : / #), URL-encode them.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/urlshortener

# Secret used to sign JWTs (minimum 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origin(s) allowed by CORS. Separate several with commas.
FRONTEND_URL=http://localhost:5173

# Public base URL of this API. Short links are built as BASE_URL/<short_code>.
BASE_URL=http://localhost:8000

# Set to true ONLY when running behind a trusted reverse proxy (Nginx, Cloudflare...).
# It makes the app read the client IP / country from X-Forwarded-For / CF-IPCountry.
TRUST_PROXY_HEADERS=false

# bcrypt work factor (12 is a good default; tests use a lower value).
BCRYPT_ROUNDS=12
